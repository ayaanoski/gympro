rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    // Master admin UID — bypasses all role checks
    function isMasterAdmin() {
      return request.auth != null && request.auth.uid == 'OiD59a3JirYra0N0f87chcHqUyW2';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isMasterAdmin() || (isAuthenticated() && getUserRole() == 'admin');
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() == 'staff';
    }

    function isTrainer() {
      return isAuthenticated() && getUserRole() == 'trainer';
    }

    function isMember() {
      return isAuthenticated() && getUserRole() == 'member';
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    function isEmployee() {
      return isAdmin() || isStaff() || isTrainer();
    }

    function isAssignedTrainer(trainerId) {
      return isTrainer() && request.auth.uid == trainerId;
    }

    function isOwnUser(uid) {
      return request.auth.uid == uid;
    }

    // ============================================================
    // users/{uid}
    // ============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwnUser(userId) || isEmployee());
      allow create: if isAuthenticated() && (isOwnUser(userId) || isAdminOrStaff());
      allow update: if isAuthenticated() && (
        (isOwnUser(userId) && request.resource.data.keys().hasOnly(['qr_code', 'name', 'phone']))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // members/{docId}
    // ============================================================

    match /members/{memberId} {
      allow read: if isAuthenticated() && (
        isEmployee() || resource.data.auth_uid == request.auth.uid
      );
      allow create: if isAdminOrStaff();
      allow update: if isAuthenticated() && (
        isAdmin()
        || (isStaff() && !request.resource.data.keys().hasAny(['auth_uid']))
        || (isTrainer() && resource.data.trainer_id == request.auth.uid
            && request.resource.data.keys().hasOnly(['trainer_id', 'trainer_name']))
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // plans/{docId}
    // ============================================================

    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // payments/{docId}
    // ============================================================

    match /payments/{paymentId} {
      allow read: if isAdminOrStaff();
      // Members read payments via the app — the app queries by member_id.
      // The member doc has auth_uid which links to the Firebase Auth user.
      // We trust the app to only query the member's own payments.
      allow create: if isAdminOrStaff();
      allow update: if false; // Payments are immutable after creation
      allow delete: if isAdmin();
    }

    // ============================================================
    // staff_attendance/{docId}
    // ============================================================

    match /staff_attendance/{attendanceId} {
      allow read: if isEmployee() || (isMember() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // workout_plans/{docId}
    // ============================================================

    match /workout_plans/{planId} {
      allow read: if isEmployee();
      allow create: if isTrainer();
      allow update: if isTrainer();
      allow delete: if isAdmin();
    }

    // ============================================================
    // diet_plans/{docId}
    // ============================================================

    match /diet_plans/{planId} {
      allow read: if isEmployee();
      allow create: if isTrainer();
      allow update: if isTrainer();
      allow delete: if isAdmin();
    }

    // ============================================================
    // progress/{docId}
    // ============================================================

    match /progress/{progressId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
      allow update: if false; // Progress logs are immutable — add new entry instead
      allow delete: if isAdmin();
    }

    // ============================================================
    // trainer_earnings/{docId}
    // ============================================================

    match /trainer_earnings/{earningId} {
      allow read: if isAdmin() || (isTrainer() && resource.data.trainer_id == request.auth.uid);
      allow create: if isAdminOrStaff() || (isTrainer() && request.resource.data.trainer_id == request.auth.uid);
      allow update: if false; // Earnings are immutable after creation
      allow delete: if isAdmin();
    }

    // ============================================================
    // member_documents/{docId}
    // ============================================================

    match /member_documents/{documentId} {
      allow read: if isAdminOrStaff();
      allow create: if isAdminOrStaff();
      allow update: if false; // Documents are immutable — upload new version instead
      allow delete: if isAdmin();
    }
  }
}
